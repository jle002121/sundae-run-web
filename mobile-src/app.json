{
  "expo": {
    "name": "Sundae Run",
    "slug": "sundae-run",
    "version": "1.0.0",
    "scheme": "sundaerun",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "manifest": {
        "short_name": "Sundae Run",
        "name": "Sundae Run",
        "description": "Track your ice cream streaks",
        "display": "standalone",
        "orientation": "portrait",
        "theme_color": "#5B3FA6",
        "background_color": "#F7F0FF"
      }
    },
    "ios": { "supportsTablet": false },
    "plugins": ["expo-router", "expo-image-picker"]
  }
}
